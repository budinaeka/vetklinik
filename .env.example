# Konfigurasi Asisten Kasus (AI) — OPSIONAL.
# Salin berkas ini menjadi ".env" (tanpa akhiran .example), lalu isi kunci Anda.
# Fitur klinik lainnya tetap berjalan tanpa ini; hanya menu "Asisten Kasus" yang butuh kunci.

# Kunci API Anthropic (Claude). Dapatkan di https://console.anthropic.com
ANTHROPIC_API_KEY=

# (Opsional) Model yang dipakai. Default: claude-opus-5.
# Untuk lebih hemat/cepat bisa diganti, mis. claude-sonnet-5 atau claude-haiku-4-5.
# ASISTEN_MODEL=claude-opus-5

# (Opsional) Ganti port server.
# PORT=3000
